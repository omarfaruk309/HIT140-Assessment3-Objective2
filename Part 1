## 2. Helper functions
`get_json` downloads one link and converts the JSON text into Python lists and dictionaries.
FIFA stores names as a list of translations, so `name` picks the English description.


def get_json(url):
    """Download a FIFA link and return the parsed JSON (retries up to 3 times)."""
    request = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                return json.loads(response.read().decode("utf-8"))
        except Exception as error:
            if attempt == 2:
                raise
            print("Retrying", url, error)
            time.sleep(2)


def name(field):
    """FIFA names look like [{"Locale": "en-GB", "Description": "Mexico"}]; return the text."""
    return field[0]["Description"] if field else ""


def clean(value):
    """Keep integers as integers and round decimals to 3 places; missing values become blank."""
    if value is None:
        return ""
    if isinstance(value, float):
        return int(value) if value.is_integer() else round(value, 3)
    return value


## 3. Download the match list
One request returns all 104 matches. Each match holds the two teams, the score after 90 or 120 minutes,
the penalty shootout score (if any), the stadium and an `IdIFES` number that the statistics feed needs.


if DOWNLOAD:
    matches = get_json(f"{API}/calendar/matches?idCompetition={WORLD_CUP}"
                       f"&idSeason={SEASON_2026}&count=200&language=en")["Results"]
    print("Matches downloaded:", len(matches))
    # Show the structure of one match so the fields used later are visible.
    first = matches[0]
    print(name(first["Home"]["TeamName"]), first["HomeTeamScore"], "-",
          first["AwayTeamScore"], name(first["Away"]["TeamName"]),
          "| stats id (IdIFES):", first["Properties"]["IdIFES"])
else:
    print("DOWNLOAD is False: skipping. The saved file is loaded in Block 7.")

## 4. Download the team statistics for every match
The statistics feed returns `{team_id: [[stat_name, value, flag], ...]}`.
Each team in each match becomes **one row**: match details first, then all 142 statistics as columns.
The home team is stored as `team1` and the away team as `team2`, following FIFA's fixture order.


if DOWNLOAD:
    rows, stat_names = [], None
    for i, m in enumerate(matches, 1):
        team_stats = get_json(STATS_API.format(m["Properties"]["IdIFES"]))
        sides = [(m["Home"], m["Away"], m["HomeTeamScore"], m["AwayTeamScore"], m["HomeTeamPenaltyScore"], "team1"),
                 (m["Away"], m["Home"], m["AwayTeamScore"], m["HomeTeamScore"], m["AwayTeamPenaltyScore"], "team2")]
        for team, opp, goals, opp_goals, pens, listed_as in sides:
            stat_list = team_stats[team["IdTeam"]]
            if stat_names is None:                       # fix the column order once
                stat_names = [s[0] for s in stat_list]
            values = {s[0]: s[1] for s in stat_list}     # {"Goals": 2, "XG": 1.78, ...}
            rows.append([m["MatchNumber"], m["Date"][:10], name(m["StageName"]), name(m["GroupName"]),
                         name(team["TeamName"]), team["Abbreviation"], name(opp["TeamName"]), listed_as,
                         goals, opp_goals, clean(pens), name(m["Stadium"]["CityName"]),
                         m["Stadium"]["IdCountry"], m["Attendance"]]
                        + [clean(values.get(s)) for s in stat_names])
        print(f"match {i}/{len(matches)}", end="\r")
    print("\nRows built:", len(rows), "| statistics per row:", len(stat_names))
else:
    print("DOWNLOAD is False: skipping.")


## 5. Save the match statistics as CSV
`csv.writer` turns the list of rows into a CSV file. The first row is the header.


if DOWNLOAD:
    header = ["match_number", "date", "stage", "group", "team", "team_code", "opponent", "listed_as",
              "goals", "opponent_goals", "penalty_score", "city", "host_country", "attendance"] + stat_names
    with open(RAW / "fifa_team_match_stats.csv", "w", newline="", encoding="utf-8") as f:
        csv.writer(f).writerows([header] + rows)
    print("Saved", RAW / "fifa_team_match_stats.csv")
else:
    print("DOWNLOAD is False: skipping.")



